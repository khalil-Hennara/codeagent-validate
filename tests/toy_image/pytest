#!/usr/bin/env python3
# minimal pytest -rA stand-in for infra tests: runs test_* functions, prints PASSED/FAILED lines
import importlib.util, sys, os, traceback
sys.path.insert(0, os.getcwd())
files = [a for a in sys.argv[1:] if not a.startswith("-")]
for f in files:
    spec = importlib.util.spec_from_file_location("m", f); m = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(m)
    except Exception:
        traceback.print_exc(); print(f"ERROR {f}"); continue
    for n in dir(m):
        if n.startswith("test_"):
            try:
                getattr(m, n)(); print(f"PASSED {f}::{n}")
            except Exception:
                print(f"FAILED {f}::{n}")
